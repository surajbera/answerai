{
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.node.json"
    }
  ],
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  }
}
// Koi fallback/priority system nahi hai. Both files are independent — duplication 
// safety ke liye hai, because agar koi tool root config hi read kare to bhi alias 
// miss na ho. Agar tum sirf tsc (TypeScript's own compiler) use karo, to sirf 
// tsconfig.app.json ka paths hi actually matter karega compilation ke waqt.